<Window x:Class="ScraperTool.Views.ProviderGridSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ScraperTool.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:AiSetupViewModel}"
        Title="Select AI Provider"
        Height="580" Width="950"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13"
        ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ScraperTool;component/Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Select an AI provider to use for analysis:" Margin="0,0,0,8" Foreground="#555" />

        <DataGrid Grid.Row="1" x:Name="ProviderGrid"
                  ItemsSource="{Binding Options}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  GridLinesVisibility="Horizontal"
                  BorderBrush="#DDD" BorderThickness="1"
                  MouseDoubleClick="OnRowDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Provider" Binding="{Binding DisplayName}" Width="160">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="ToolTip" Value="{Binding DisplayName}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="ID" Binding="{Binding ProviderId}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="ToolTip" Value="{Binding ProviderId}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="ToolTip" Value="{Binding Category}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="ToolTip" Value="{Binding Protocol}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Website" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Website}" TextTrimming="CharacterEllipsis"
                                       Foreground="#06C" TextDecorations="Underline" Cursor="Hand"
                                       MouseLeftButtonDown="OnWebsiteClick">
                                <TextBlock.ToolTip>
                                    <ToolTip MaxWidth="400">
                                        <TextBlock Text="{Binding Website}" TextWrapping="Wrap" />
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Description" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ModelDescription}" TextTrimming="CharacterEllipsis">
                                <TextBlock.ToolTip>
                                    <ToolTip MaxWidth="400">
                                        <TextBlock Text="{Binding ModelDescription}" TextWrapping="Wrap" />
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridCheckBoxColumn Header="Free Tier" Binding="{Binding HasFreeTier}" Width="65" />
                <DataGridCheckBoxColumn Header="Pay as You Go" Binding="{Binding PayAsYouGo}" Width="85" />
                <DataGridCheckBoxColumn Header="Disc. Models" Binding="{Binding HasModelDiscovery}" Width="85" />
                <DataGridCheckBoxColumn Header="Fine-Tuning" Binding="{Binding SupportsFineTuning}" Width="75" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="SelectButton" Content="Select" IsDefault="True"
                    Padding="14,5" Margin="0,0,8,0" Click="OnSelect" />
            <Button Content="Cancel" IsCancel="True" Padding="14,5" />
        </StackPanel>
    </Grid>
</Window>
