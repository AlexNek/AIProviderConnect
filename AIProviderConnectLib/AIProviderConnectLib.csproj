<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    
    <RootNamespace>AIProviderConnect</RootNamespace>
    <AssemblyName>AIProviderConnect</AssemblyName>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Authors>Alex Nek</Authors>
    <Company>Alex Nek</Company>
    <Product>AIProviderConnect</Product>
    <Description>A unified .NET library for connecting to 35+ AI providers (OpenAI, Anthropic, Gemini, Ollama, Groq, Mistral, xAI and more) with runtime model discovery, streaming, tool calling, and DI support.</Description>
    <Copyright>Copyright (c) 2026 Alex Nek</Copyright>

    <!-- NuGet metadata -->
    <PackageId>AIProviderConnect</PackageId>
    <Title>AIProviderConnect</Title>
    <PackageTags>ai;llm;openai;anthropic;gemini;ollama;groq;mistral;chatgpt;claude;generative-ai;streaming;tool-calling</PackageTags>
    <PackageProjectUrl>https://github.com/AlexNek/AIProviderConnect</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AlexNek/AIProviderConnect</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>NuGetReadme.md</PackageReadmeFile>
    <PackageIcon>package.png</PackageIcon>

    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    
    <!-- NuGet packaging -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
    <PackageReference Include="Polly.Core" Version="8.*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ai-providers\*.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared parsing helpers are internal by design; the unit-test assembly needs direct access. -->
    <InternalsVisibleTo Include="AIProviderConnectLib.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\NuGetReadme.md" Pack="true" PackagePath="\" />
    <None Include="package.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <None Update="ai-providers\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>