<UserControl x:Class="ScraperTool.Controls.UrlFixActionBar" x:Name="ThisControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Fix with AI buttons -->
        <Border Padding="8,4"
                Visibility="{Binding HasUrlIssues, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <Button Content="Fix with AI"
                        Command="{Binding AiFixUrlsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Padding="10,4" Background="#E65100" Foreground="White" BorderThickness="0" FontWeight="SemiBold" />
                <Button Content="Retry Failed"
                        Command="{Binding AiRetryFailedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Padding="10,4" Background="#C62828" Foreground="White" BorderThickness="0" FontWeight="SemiBold"
                        Visibility="{Binding HasFailedItems, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                        Margin="6,0,0,0" />
                <TextBlock Text="Sends broken URLs to AI for correction suggestions" Foreground="#666"
                           VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12" />
            </StackPanel>
        </Border>

        <!-- AI setup banner -->
        <Border Padding="8,4"
                Visibility="{Binding HasAiSetupNeeded, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="AI not configured — set it up to auto-fix broken URLs:" Foreground="#E65100"
                           VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" />
                <Button Content="AI Setup"
                        Command="{Binding OpenAiSetupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Padding="10,4" Background="#E65100" Foreground="White" BorderThickness="0" FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <!-- Token usage + cost summary -->
        <Border Padding="8,6" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4"
                Visibility="{Binding HasTokenUsage, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Tokens:" FontWeight="SemiBold" Foreground="#333"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Grid.Column="1"
                           Text="{Binding TokenSummary, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="#555" VerticalAlignment="Center"
                           FontFamily="Cascadia Code, Consolas, Courier New" FontSize="12"
                           Margin="0,0,16,0" />
                <TextBlock Grid.Column="2"
                           Text="{Binding CostSummary, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="#777" VerticalAlignment="Center" FontSize="11"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
