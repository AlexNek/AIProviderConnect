<UserControl x:Class="ScraperTool.Controls.AiUsageHistoryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ScraperTool.ViewModels"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1100"
             d:DataContext="{d:DesignInstance Type=vm:AiUsageHistoryViewModel}">
    <UserControl.Resources>
        <ContextMenu x:Key="RowContextMenu">
            <MenuItem Click="CopyRow_Click" Header="Copy Row" />
            <Separator />
            <MenuItem Click="CopyTable_Click" Header="Copy Table" />
        </ContextMenu>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FAFAFA" Padding="16,12" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="AI Usage History" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,16,0" />
                <TextBlock Text="Operation:" VerticalAlignment="Center"
                           Foreground="#555" Margin="0,0,4,0" />
                <ComboBox ItemsSource="{Binding OperationFilters}"
                          SelectedItem="{Binding OperationFilter}"
                          VerticalAlignment="Center" Width="120" Margin="0,0,12,0" />
                <TextBlock Text="Provider:" VerticalAlignment="Center"
                           Foreground="#555" Margin="0,0,4,0" />
                <ComboBox ItemsSource="{Binding ProviderFilters}"
                          SelectedItem="{Binding ProviderFilter}"
                          VerticalAlignment="Center" Width="130" />
                <Button Content="Clear All" Command="{Binding ClearHistoryCommand}"
                        Padding="10,4" Background="#C62828" Foreground="White" BorderThickness="0"
                        FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- DataGrid -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <DataGrid ItemsSource="{Binding Entries}" AutoGenerateColumns="False" IsReadOnly="True"
                          RowHeaderWidth="0" AlternatingRowBackground="#E8F4FF" Margin="8,8,8,0"
                          MaxHeight="400" FontSize="12">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="ContextMenu" Value="{StaticResource RowContextMenu}" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, StringFormat='{}{0:g}'}" Width="130" />
                        <DataGridTextColumn Header="Provider" Binding="{Binding ProviderName}" Width="120" />
                        <DataGridTextColumn Header="Model" Binding="{Binding ModelName}" Width="170" />
                        <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="100" />
                        <DataGridTextColumn Header="Prompt" Binding="{Binding PromptTokens, StringFormat='{}{0:N0}'}" Width="80" />
                        <DataGridTextColumn Header="Completion" Binding="{Binding CompletionTokens, StringFormat='{}{0:N0}'}" Width="90" />
                        <DataGridTextColumn Header="Total" Binding="{Binding TotalTokens, StringFormat='{}{0:N0}'}" Width="80" />
                        <DataGridTextColumn Header="Cost" Binding="{Binding Cost, StringFormat='{}{0:C4}'}" Width="90" />
                        <DataGridTextColumn Header="Source" Binding="{Binding CostSource}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Summary -->
                <Border Padding="12,8" Margin="8,4,8,0" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4">
                    <TextBlock Text="{Binding SummaryLine}" Foreground="#444" FontSize="12" FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom bar -->
        <Border Grid.Row="2" Background="#E8E8E8" Padding="12,6">
            <Button Content="&#x2190; Back to dashboard" Command="{Binding GoBackCommand}"
                    Background="Transparent" BorderThickness="0" Foreground="#0078D4" Cursor="Hand" FontWeight="SemiBold" />
        </Border>
    </Grid>
</UserControl>
