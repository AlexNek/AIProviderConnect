<UserControl x:Class="ScraperTool.Controls.KeyValueEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="200" d:DesignWidth="400">
    <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="16">
        <StackPanel>
            <TextBlock x:Name="TitleElement" FontWeight="SemiBold" Foreground="#333"
                       Margin="0,0,0,8" FontSize="14" />
            <TextBlock x:Name="DescriptionElement" Foreground="#666" FontSize="11"
                       Margin="0,0,0,8" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="KeyComboBox" Grid.Column="0"
                                      ItemsSource="{Binding KnownKeys}"
                                      SelectedItem="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                      Padding="6,4" Margin="0,0,6,0"
                                      ToolTip="Configuration key name"
                                      Visibility="Collapsed" />
                            <TextBox x:Name="KeyTextBox" Grid.Column="0" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="6,4" Margin="0,0,6,0"
                                     ToolTip="Configuration key name" />
                            <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="6,4" Margin="0,0,6,0"
                                     ToolTip="Configuration value" />
                            <Button Grid.Column="2" Content="✕" Padding="8,4"
                                    Command="{Binding RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="Remove this entry" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding HasKnownKeys}" Value="True">
                                <Setter TargetName="KeyComboBox" Property="Visibility" Value="Visible" />
                                <Setter TargetName="KeyTextBox" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="+ Add Entry"
                    Command="{Binding AddCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    HorizontalAlignment="Left" Padding="12,6" Margin="0,4,0,0"
                    Background="#E3F2FD" Foreground="#1565C0" BorderThickness="0"
                    FontWeight="SemiBold" />
        </StackPanel>
    </Border>
</UserControl>
