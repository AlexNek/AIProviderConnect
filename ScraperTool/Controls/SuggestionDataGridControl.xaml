<UserControl
    x:Class="ScraperTool.Controls.SuggestionDataGridControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="ThisControl">
    <UserControl.Resources>
        <ContextMenu x:Key="RowContextMenu">
            <MenuItem Click="CopyRow_Click" Header="Copy Row" />
            <Separator />
            <MenuItem Click="CopyAll_Click" Header="Copy All" />
        </ContextMenu>
    </UserControl.Resources>
    <StackPanel>
        <DataGrid
            MaxHeight="300"
            AlternatingRowBackground="{Binding AltRowBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
            AutoGenerateColumns="False"
            IsReadOnly="False"
            ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
            RowHeaderWidth="0">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="ContextMenu" Value="{StaticResource RowContextMenu}" />
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn
                    Width="70"
                    Binding="{Binding IsApproved, UpdateSourceTrigger=PropertyChanged}"
                    Header="Approve">
                    <DataGridCheckBoxColumn.ElementStyle>
                        <Style TargetType="CheckBox">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridCheckBoxColumn.ElementStyle>
                    <DataGridCheckBoxColumn.EditingElementStyle>
                        <Style TargetType="CheckBox">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridCheckBoxColumn.EditingElementStyle>
                </DataGridCheckBoxColumn>
                <DataGridCheckBoxColumn
                    Width="60"
                    Binding="{Binding IsRejected, UpdateSourceTrigger=PropertyChanged}"
                    Header="Reject">
                    <DataGridCheckBoxColumn.ElementStyle>
                        <Style TargetType="CheckBox">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridCheckBoxColumn.ElementStyle>
                    <DataGridCheckBoxColumn.EditingElementStyle>
                        <Style TargetType="CheckBox">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridCheckBoxColumn.EditingElementStyle>
                </DataGridCheckBoxColumn>
                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding DisplayName}"
                    Header="Provider" />
                <DataGridTextColumn
                    Width="90"
                    Binding="{Binding Field}"
                    Header="Field" />
                <DataGridTemplateColumn Width="250" Header="Current value">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{Binding CurrentValue}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding CurrentValue}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="250" Header="Suggested value">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="{Binding SuggestedValue}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding SuggestedValue}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn
                    Width="*"
                    MinWidth="150"
                    Header="Reason">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{Binding Reason}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding Reason}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Margin="0" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="#666"
                    Text="{Binding ItemsSource.Count, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat='{}{0} suggestion(s)'}" />
                <Button
                    Margin="0,0,4,0"
                    Padding="8,2"
                    Command="{Binding SelectAllCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="Select All" />
                <Button
                    Margin="0,0,8,0"
                    Padding="8,2"
                    Command="{Binding DeselectAllCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="Deselect All" />
                <Button
                    Padding="8,2"
                    Background="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    BorderThickness="0"
                    Command="{Binding ApplyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="Apply approved"
                    Foreground="White" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
