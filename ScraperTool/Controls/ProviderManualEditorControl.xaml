<UserControl x:Class="ScraperTool.Controls.ProviderManualEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ScraperTool.Controls"
             xmlns:converters="clr-namespace:ScraperTool.Converters"
             xmlns:vm="clr-namespace:ScraperTool.ViewModels"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1100"
             d:DataContext="{d:DesignInstance Type=vm:ProviderManualEditorViewModel}">
    <UserControl.Resources>
        <converters:ValidationLevelToColorConverter x:Key="ValidationLevelToColor" />
        <converters:ValidationLevelToTextColorConverter x:Key="ValidationLevelToTextColor" />
        <converters:ValidationStateToColorConverter x:Key="ValidationStateToColor" />
        <converters:ValidationStateToBorderConverter x:Key="ValidationStateToBorder" />
    </UserControl.Resources>
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Cursor" Value="Wait" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FAFAFA" Padding="16,12" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Manual Provider Editor" FontSize="16" FontWeight="SemiBold"
                               Foreground="#333" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SelectedProvider.Summary}"
                               VerticalAlignment="Center" Margin="16,0,0,0"
                               Foreground="#777" FontSize="12"
                               TextTrimming="CharacterEllipsis" MaxWidth="500" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" Foreground="#555" VerticalAlignment="Center"
                               Margin="0,0,12,0" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="350" />
                    <ProgressBar Width="80" Height="14" IsIndeterminate="{Binding IsBusy}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0" />
                    <Button Content="Save" Command="{Binding SaveCommand}"
                            Background="#0078D4" Foreground="White" Padding="16,6"
                            FontWeight="SemiBold" BorderThickness="0"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    <Button Content="Revert" Command="{Binding RevertCommand}"
                            Padding="14,6" Margin="8,0,0,0"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    <Button Content="Mark as Valid" Command="{Binding MarkAsManuallyValidatedCommand}"
                            Background="#2196F3" Foreground="White" Padding="14,6" Margin="8,0,0,0"
                            FontWeight="SemiBold" BorderThickness="0"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    <Button Content="Revalidate" Command="{Binding RevalidateProviderCommand}"
                            Background="#FF9800" Foreground="White" Padding="14,6" Margin="8,0,0,0"
                            FontWeight="SemiBold" BorderThickness="0"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                            ToolTip="Deletes validation sidecar so the issue reappears in Check Data" />
                    <Button Content="Cancel" Command="{Binding CancelOperationCommand}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                            IsEnabled="{Binding IsPaused, Converter={StaticResource InverseBool}}"
                            Background="#C62828" Foreground="White" Padding="10,4" Margin="6,0,0,0"
                            FontWeight="SemiBold" BorderThickness="0" />
                    <Button Content="Pause" Command="{Binding PauseOperationCommand}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                            IsEnabled="{Binding IsPaused, Converter={StaticResource InverseBool}}"
                            Background="#E65100" Foreground="White" Padding="10,4" Margin="6,0,0,0"
                            FontWeight="SemiBold" BorderThickness="0" />
                    <Button Content="Resume" Command="{Binding ResumeOperationCommand}"
                            Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}"
                            Background="#009688" Foreground="White" Padding="10,4" Margin="6,0,0,0"
                            FontWeight="SemiBold" BorderThickness="0" />
                    <Button Content="Back" Command="{Binding GoBackCommand}"
                            Padding="14,6" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Provider list -->
            <Border Grid.Column="0" Background="#F8F9FA" BorderBrush="#DDD" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#ECEFF1" Padding="12,8" BorderBrush="#DDD" BorderThickness="0,0,0,1">
                        <TextBlock Text="Providers" FontWeight="SemiBold" Foreground="#455A64" />
                    </Border>
                    <Border Grid.Row="1" Padding="10,8" BorderBrush="#DDD" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="Search" FontSize="11" Foreground="#666" Margin="0,0,0,3" />
                            <TextBox x:Name="SearchTextBox"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center"
                                     Padding="6,4"
                                     ToolTip="Search by name, ID, protocol, or category" />
                        </StackPanel>
                    </Border>
                    <ListBox Grid.Row="2" x:Name="ProviderListBox"
                             ItemsSource="{Binding FilteredProviders}"
                             SelectedItem="{Binding SelectedProvider}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="4,6" Background="{Binding ValidationLevel, Converter={StaticResource ValidationLevelToColor}}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                       Foreground="#263238" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ValidationDisplay}" 
                                                       Foreground="{Binding ValidationLevel, Converter={StaticResource ValidationLevelToTextColor}}"
                                                       FontSize="10" FontWeight="SemiBold"
                                                       Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock FontSize="11" Foreground="#607D8B" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0}  •  {1}">
                                                    <Binding Path="Protocol" />
                                                    <Binding Path="Category" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Form -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,16">

                    <!-- Basic info -->
                    <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <Label Content="_ID" Target="{Binding ElementName=IdTextBox}" Padding="0,0,0,2" />
                                <TextBox x:Name="IdTextBox" Text="{Binding Id}" IsReadOnly="True" Background="#F5F5F5" Margin="0,0,0,12"
                                         ToolTip="Unique provider identifier. This also determines the JSON file name." />

                                <Label Content="_Display name" Target="{Binding ElementName=DisplayNameTextBox}" Padding="0,0,0,2" />
                                <TextBox x:Name="DisplayNameTextBox" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"
                                         ToolTip="Human-readable name shown in the UI." />

                                <Label Content="_Protocol" Target="{Binding ElementName=ProtocolComboBox}" Padding="0,0,0,2" />
                                <ComboBox x:Name="ProtocolComboBox" ItemsSource="{Binding Protocols}"
                                          SelectedItem="{Binding Protocol}" Margin="0,0,0,12"
                                          ToolTip="Wire protocol used to communicate with this provider's API." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <Label Content="_Category" Target="{Binding ElementName=CategoryComboBox}" Padding="0,0,0,2" />
                                <ComboBox x:Name="CategoryComboBox" ItemsSource="{Binding Categories}"
                                          SelectedItem="{Binding Category}" Margin="0,0,0,12"
                                          ToolTip="Provider classification (e.g. DirectProvider, HostedInference, AIGateway)." />

                                <Label Content="_Model description" Target="{Binding ElementName=ModelDescriptionTextBox}" Padding="0,0,0,2" />
                                <TextBox x:Name="ModelDescriptionTextBox" Text="{Binding ModelDescription, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="True" Height="70" VerticalScrollBarVisibility="Auto"
                                         ToolTip="Short description of the models or service offered by this provider." />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Validation State -->
                    <Border Background="{Binding ValidationStateDisplay, Converter={StaticResource ValidationStateToColor}}"
                            BorderBrush="{Binding ValidationStateDisplay, Converter={StaticResource ValidationStateToBorder}}"
                            BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,8" FontSize="14">
                                Validation Status
                            </TextBlock>
                            <TextBlock Text="{Binding ValidationStateDisplay}" 
                                       Foreground="#555" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                            
                            <!-- Validation Errors (shown when has errors) -->
                            <StackPanel Visibility="{Binding HasValidationErrors, Converter={StaticResource BoolToVis}}">
                                <TextBlock FontWeight="SemiBold" Foreground="#D32F2F" FontSize="12" Margin="0,0,0,4">
                                    Errors:
                                </TextBlock>
                                <Border Background="#FFF3F3" BorderBrush="#FFCDD2" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,0,8">
                                    <TextBox Text="{Binding ValidationErrorsText, Mode=OneWay}" 
                                             IsReadOnly="True" 
                                             TextWrapping="Wrap" 
                                             BorderThickness="0" 
                                             Background="Transparent"
                                             FontFamily="Consolas"
                                             FontSize="11"
                                             Foreground="#D32F2F"
                                             MaxHeight="150"
                                             VerticalScrollBarVisibility="Auto" />
                                </Border>
                                <Button Content="Copy Errors to Clipboard" 
                                        Command="{Binding CopyValidationErrorsCommand}"
                                        HorizontalAlignment="Left"
                                        Padding="12,6"
                                        Margin="0,0,0,8"
                                        Background="#FF5722" 
                                        Foreground="White" 
                                        BorderThickness="0" 
                                        FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- URLs -->
                    <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <controls:UrlEditControl Url="{Binding Website, UpdateSourceTrigger=PropertyChanged}"
                                                         Label="_Website" OpenCommand="{Binding OpenLinkCommand}" CommandParameter="website"
                                                         ToolTip="Public marketing or homepage URL for the provider." />
                                <controls:UrlEditControl Url="{Binding LoginUrl, UpdateSourceTrigger=PropertyChanged}"
                                                         Label="_Login URL" OpenCommand="{Binding OpenLinkCommand}" CommandParameter="loginUrl" Margin="0,10,0,0"
                                                         ToolTip="URL to the provider's dashboard/console where you sign in to create API keys." />
                                <controls:UrlEditControl Url="{Binding ApiPricingUrl, UpdateSourceTrigger=PropertyChanged}"
                                                         Label="_API Pricing URL" OpenCommand="{Binding OpenLinkCommand}" CommandParameter="apiPricingUrl" Margin="0,10,0,0"
                                                         ToolTip="URL to the provider's API pricing page." />
                                <controls:UrlEditControl Url="{Binding SubscriptionPricingUrl, UpdateSourceTrigger=PropertyChanged}"
                                                         Label="_Subscription Pricing URL" OpenCommand="{Binding OpenLinkCommand}" CommandParameter="subscriptionPricingUrl" Margin="0,10,0,0"
                                                         ToolTip="URL to the provider's subscription pricing page." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <controls:UrlEditControl Url="{Binding DocumentationUrl, UpdateSourceTrigger=PropertyChanged}"
                                                         Label="_Documentation URL" OpenCommand="{Binding OpenLinkCommand}" CommandParameter="documentationUrl"
                                                         ToolTip="URL to the provider's API documentation homepage." />
                                <controls:UrlEditControl Url="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                                         Label="_Base URL" OpenCommand="{Binding OpenLinkCommand}" CommandParameter="baseUrl" Margin="0,10,0,0"
                                                         ToolTip="API service root URL. Include the version path if the provider requires it (e.g. https://api.example.com/v1/)." />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Endpoints -->
                    <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <Label Content="_Chat endpoint" Target="{Binding ElementName=ChatEndpointTextBox}" Padding="0,0,0,2" />
                                <TextBox x:Name="ChatEndpointTextBox" Text="{Binding ChatEndpoint, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Relative path appended to Base URL for chat completion requests." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <Label Content="_Models endpoint" Target="{Binding ElementName=ModelsEndpointTextBox}" Padding="0,0,0,2" />
                                <TextBox x:Name="ModelsEndpointTextBox" Text="{Binding ModelsEndpoint, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Relative path appended to Base URL to list available models." />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Protocol Configuration -->
                    <controls:KeyValueEditorControl
                        Title="Protocol Configuration"
                        Description="Protocol-specific key-value pairs. Select a key from the list for the active protocol."
                        ItemsSource="{Binding ProtocolConfiguration}"
                        AddCommand="{Binding AddProtocolConfigEntryCommand}"
                        RemoveCommand="{Binding RemoveProtocolConfigEntryCommand}"
                        Visibility="{Binding HasProtocolKeys, Converter={StaticResource BoolToVis}}"
                        Margin="0,0,0,16" />

                    <!-- Discovery -->
                    <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <CheckBox Content="Has model _discovery API" IsChecked="{Binding HasModelDiscoveryApi}" Margin="0,0,0,12"
                                          ToolTip="Whether the provider exposes an endpoint to list available models." />
                                <CheckBox Content="_Dynamic model catalog" IsChecked="{Binding IsDynamicModelCatalog}" Margin="0,0,0,12"
                                          ToolTip="Provider catalog is user-managed (localhost) and cannot be verified by any external method." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <Label Content="Model discovery _notes" Target="{Binding ElementName=ModelDiscoveryNotesTextBox}" Padding="0,0,0,2" />
                                <TextBox x:Name="ModelDiscoveryNotesTextBox" Text="{Binding ModelDiscoveryNotes, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="True" Height="70" VerticalScrollBarVisibility="Auto"
                                         ToolTip="Additional notes about how model discovery works for this provider." />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Regional Endpoints -->
                    <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,16"
                            Visibility="{Binding HasRegionalEndpoints, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,8" FontSize="14">
                                Regional Endpoints
                            </TextBlock>
                            <TextBlock Foreground="#666" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap">
                                Region-specific API URLs (one per line: <Italic>key: url</Italic>). The <Italic>baseUrl</Italic> above is what you currently use; the AI fixer uses these alternatives to pick the right one for your detected region.
                            </TextBlock>
                            <Border Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="3" Padding="8">
                                <TextBox Text="{Binding RegionalEndpointsText, UpdateSourceTrigger=LostFocus}"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         MinHeight="60"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontFamily="Consolas"
                                         FontSize="11"
                                         Foreground="#333" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Flags -->
                    <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <Label Content="_Minimum commitment" Target="{Binding ElementName=MinimumCommitmentTextBox}" Padding="0,0,0,2" />
                                <TextBox x:Name="MinimumCommitmentTextBox" Text="{Binding MinimumCommitment, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Minimum amount required to use the service, if any." Margin="0,0,0,12" />

                                <Label Content="Min _model count" Target="{Binding ElementName=MinModelCountTextBox}" Padding="0,0,0,2" />
                                <TextBox x:Name="MinModelCountTextBox" Text="{Binding MinModelCount, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsDynamicModelCatalog, Converter={StaticResource InverseBool}}"
                                         ToolTip="Number of models available from the provider." />
                                <TextBlock Text="Disabled — dynamic catalog cannot be verified."
                                           FontSize="11" Foreground="#888" FontStyle="Italic" Margin="0,2,0,0"
                                           Visibility="{Binding IsDynamicModelCatalog, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                                    <CheckBox Content="Pay _as you go" IsChecked="{Binding PayAsYouGo}" Margin="0,0,16,0"
                                              ToolTip="Whether the provider supports pay-as-you-go billing." />
                                    <CheckBox Content="_Free tier" IsChecked="{Binding HasFreeTier}" Margin="0,0,16,0"
                                              ToolTip="Whether the provider offers a free tier or trial credits." />
                                    <CheckBox Content="Supports _fine-tuning" IsChecked="{Binding SupportsFineTuning}"
                                              ToolTip="Whether the provider offers custom model training on user-provided datasets (e.g., OpenAI GPT fine-tuning)." />
                                </StackPanel>
                                <Label Content="Pay-as-you-go _description" Target="{Binding ElementName=PayAsYouGoDescriptionTextBox}" Padding="0,0,0,2" />
                                <TextBox x:Name="PayAsYouGoDescriptionTextBox" Text="{Binding PayAsYouGoDescription, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Details about the provider's pay-as-you-go pricing terms." />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Elapsed time — persists as summary after operation completes -->
                    <TextBlock Margin="0,4"
                               VerticalAlignment="Center"
                               FontFamily="Cascadia Code, Consolas, Courier New"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#FF9800"
                               Text="{Binding ElapsedTime, FallbackValue='00:00:00'}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Timer.IsRunning}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasElapsedSummary}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Revalidation log -->
                    <controls:LogPanelControl ItemsSource="{Binding RevalidationLog}" Margin="0,0,0,12" />

                    <!-- Action buttons for log results -->
                    <Border Padding="8,4" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Copy Log" Command="{Binding CopyRevalidationLogCommand}"
                                    Padding="10,4" Background="#E65100" Foreground="White" BorderThickness="0" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <!-- AI Suggestions from revalidation -->
                    <controls:SuggestionDataGridControl
                        Visibility="{Binding HasAiSuggestions, Converter={StaticResource BoolToVis}}"
                        AccentBrush="#FF9800"
                        AltRowBrush="#FFF8E1"
                        ApplyCommand="{Binding ApplyApprovedSuggestionsCommand}"
                        DeselectAllCommand="{Binding DeselectAllSuggestionsCommand}"
                        ItemsSource="{Binding AiSuggestions}"
                        SelectAllCommand="{Binding SelectAllSuggestionsCommand}" />

                    <TextBlock Text="* Changes are saved to the JSON file in the configured manifest folder."
                               Foreground="#888" FontSize="11" Margin="4,0,0,8" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
