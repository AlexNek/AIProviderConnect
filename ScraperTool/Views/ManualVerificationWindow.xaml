<Window x:Class="ScraperTool.Views.ManualVerificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ScraperTool.ViewModels"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance Type=vm:ManualVerificationViewModel}"
        Title="{Binding WindowTitle}"
        Height="280" Width="520"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Cloudflare bot protection detected"
                   FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" />

        <TextBlock Grid.Row="1"
                   Text="Click 'Open Browser' to open a visible browser window. Solve the Cloudflare challenge manually — verification and browser close are automatic."
                   TextWrapping="Wrap" Margin="0,0,0,12" />

        <TextBlock Grid.Row="2" Margin="0,0,0,4">
            <Run FontWeight="SemiBold" Text="Field: " />
            <Run Text="{Binding Field, Mode=OneWay}" />
        </TextBlock>

        <TextBlock Grid.Row="3" Margin="0,0,0,4">
            <Run FontWeight="SemiBold" Text="URL: " />
            <Run Text="{Binding Url, Mode=OneWay}" />
        </TextBlock>

        <TextBlock Grid.Row="4" Text="{Binding StatusText}"
                   TextWrapping="Wrap"
                   Foreground="#666" VerticalAlignment="Top" Margin="0,8,0,0" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Open Browser"
                    Padding="10,4" Margin="0,0,8,0"
                    Command="{Binding OpenBrowserCommand}" />
            <Button Content="Cancel" IsCancel="True" Padding="10,4"
                    Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</Window>
