<UserControl
    x:Class="ScraperTool.Controls.IssuesDataGridControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="ThisControl">
    <UserControl.Resources>
        <ContextMenu x:Key="RowContextMenu" DataContext="{Binding DataContext, Source={x:Reference ThisControl}}">
            <MenuItem
                Command="{Binding AiFixSingleIssueCommand}"
                CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                Header="Fix with AI" />
            <Separator />
            <MenuItem Click="CopyRow_Click" Header="Copy Row" />
            <MenuItem Click="CopyTable_Click" Header="Copy Table" />
        </ContextMenu>
    </UserControl.Resources>
    <DataGrid
        MaxHeight="300"
        AlternatingRowBackground="#E0F2F1"
        AutoGenerateColumns="False"
        IsReadOnly="True"
        ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
        RowHeaderWidth="0">
        <DataGrid.RowStyle>
            <Style TargetType="DataGridRow">
                <Setter Property="ContextMenu" Value="{StaticResource RowContextMenu}" />
            </Style>
        </DataGrid.RowStyle>
        <DataGrid.Columns>
            <DataGridTextColumn
                Width="100"
                Binding="{Binding Code}"
                Header="Code" />
            <DataGridTextColumn
                Width="120"
                Binding="{Binding FileName}"
                Header="File" />
            <DataGridTextColumn
                Width="*"
                Binding="{Binding Message}"
                Header="Message" />
        </DataGrid.Columns>
    </DataGrid>
</UserControl>
