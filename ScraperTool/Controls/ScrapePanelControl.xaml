<UserControl x:Class="ScraperTool.Controls.ScrapePanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ScraperTool.Controls"
             xmlns:vm="clr-namespace:ScraperTool.ViewModels"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1100"
             d:DataContext="{d:DesignInstance Type=vm:ScrapePanelViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Description + Start -->
        <Border Grid.Row="0" Background="#FAFAFA" Padding="16,12" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Scrapes model prices from each provider's pricing page. Results are saved to the database."
                           TextWrapping="Wrap" Foreground="#555" VerticalAlignment="Center" Margin="0,0,16,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="120" Height="16" IsIndeterminate="{Binding IsBusy}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0" />
                    <Button Content="Start" Command="{Binding StartWorkCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                            Background="#0078D4" Foreground="White" Padding="16,6"
                            FontWeight="SemiBold" BorderThickness="0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Scrollable results -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <DataGrid x:Name="ResultsGrid" ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="True"
                          RowHeaderWidth="0" AlternatingRowBackground="#F5F9FF" Margin="8,8,8,0"
                          Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}"
                          MaxHeight="300"
                          ClipboardCopyMode="IncludeHeader">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy selected rows" Click="OnCopySelectedRows" InputGestureText="Ctrl+C" />
                            <MenuItem Header="Copy cell value" Click="OnCopyCellValue" />
                            <Separator />
                            <MenuItem Header="Copy all as TSV" Click="OnCopyAllAsTsv" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Provider" Binding="{Binding ProviderId}" Width="100" />
                        <DataGridTemplateColumn Header="Model" Width="*" MinWidth="200" SortMemberPath="ModelDisplayName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ModelDisplayName}" TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" MaxHeight="20">
                                        <TextBlock.ToolTip>
                                            <ToolTip MaxWidth="450">
                                                <TextBlock Text="{Binding ModelDisplayName}" TextWrapping="Wrap" />
                                            </ToolTip>
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Prompt price, $" Binding="{Binding PromptPrice, StringFormat=N8}" Width="120" />
                        <DataGridTextColumn Header="Completion price, $" Binding="{Binding CompletionPrice, StringFormat=N8}" Width="140" />
                        <DataGridTextColumn Header="Unit" Binding="{Binding PriceUnit}" Width="80" />
                        <DataGridTemplateColumn Header="Source" Width="*" MinWidth="100" SortMemberPath="Source">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Source}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center">
                                            <TextBlock.ToolTip>
                                                <ToolTip MaxWidth="400">
                                                    <TextBlock Text="{Binding Source}" TextWrapping="Wrap" />
                                                </ToolTip>
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                        <Button Content="🔗" Click="OnSourceLinkClick"
                                                ToolTip="Open pricing page in browser"
                                                Background="Transparent" BorderThickness="0"
                                                Padding="4,0" Margin="4,0,0,0" Cursor="Hand"
                                                FontSize="11" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕" Click="OnDeleteRowClick"
                                            ToolTip="Delete this entry from the database"
                                            Foreground="#D32F2F" Background="Transparent"
                                            BorderThickness="0" FontWeight="Bold" FontSize="14"
                                            Padding="6,0" Cursor="Hand"
                                            VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Padding="8,4" Margin="8,0,8,0"
                        Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding TotalPricesFound, StringFormat='{}{0} prices found — saved to database'}"
                               FontWeight="SemiBold" Foreground="#666" VerticalAlignment="Center" />
                </Border>

                <controls:LogPanelControl ItemsSource="{Binding Log}" Margin="8" />
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom bar -->
        <Border Grid.Row="2" Background="#E8E8E8" Padding="12,6">
            <StackPanel Orientation="Horizontal">
                <Button Content="Clear results" Command="{Binding ClearResultsCommand}"
                        Padding="8,2" />
                <Button Content="Copy log" Command="{Binding CopyLogCommand}"
                        Padding="8,2" Margin="8,0,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
