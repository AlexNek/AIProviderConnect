<Window x:Class="ScraperTool.Views.ModelGridSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScraperTool.Views"
        xmlns:c="clr-namespace:ScraperTool.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:ModelGridSelectorWindow}"
        Title="Select Model"
        Height="630" Width="1260"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13"
        ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ScraperTool;component/Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Select a model:" Margin="0,0,0,6" Foreground="#555" />

        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,0,6">
            <!-- One box per pair of columns: what is typed here is searched in Name and Owner only,
                 and those are exactly the cells it paints. See NameQuery / OwnerQuery. -->
            <TextBlock Text="Filter by name or owner" Foreground="#777" FontSize="11" Margin="0,0,0,2" />
            <TextBox x:Name="FilterBox" Margin="0" 
                 Text="{Binding NameFilterText, UpdateSourceTrigger=PropertyChanged}"
                 FontSize="13">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <VisualBrush Stretch="None" AlignmentX="Left">
                                            <VisualBrush.Visual>
                                                <TextBlock Text="model name, owner, or a pasted id such as openai/gpt-4o…" Foreground="#AAA" Margin="4,2" />
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
            <!-- Descriptions are long and the column shows only their beginning, so they get their own
                 box: typing here explains itself even when the match falls past the ellipsis. -->
            <TextBlock Text="Filter by description" Foreground="#777" FontSize="11" Margin="0,10,0,2" />
            <TextBox x:Name="DescriptionFilterBox" Margin="0"
                 Text="{Binding DescriptionFilterText, UpdateSourceTrigger=PropertyChanged}"
                 FontSize="13">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <VisualBrush Stretch="None" AlignmentX="Left">
                                            <VisualBrush.Visual>
                                                <TextBlock Text="words from the model description…" Foreground="#AAA" Margin="4,2" />
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
            <TextBlock Text="Filter by modality" Foreground="#777" FontSize="11" Margin="0,10,0,2" />
            <ComboBox x:Name="ModalityFilter" Width="260" HorizontalAlignment="Left"
                      Margin="0,0,0,0" SelectedIndex="0"
                      SelectionChanged="OnModalitySelectionChanged">
                <ComboBoxItem Content="All" />
                <ComboBoxItem Content="📝 text" />
                <ComboBoxItem Content="🖼 image" />
                <ComboBoxItem Content="🔊 audio" />
                <ComboBoxItem Content="🎬 video" />
                <ComboBoxItem Content="📄 file" />
                <ComboBoxItem Content="💻 code" />
            </ComboBox>
            <TextBlock Text="Filter by capability" Foreground="#777" FontSize="11" Margin="0,10,0,2" />
            <ComboBox x:Name="CapabilityFilter" Width="260" HorizontalAlignment="Left"
                      Margin="0,0,0,0" SelectedIndex="0"
                      SelectionChanged="OnCapabilitySelectionChanged">
                <ComboBoxItem Content="All" />
                <ComboBoxItem Content="Chat" />
                <ComboBoxItem Content="Embedding" />
                <ComboBoxItem Content="Decision" />
            </ComboBox>
            <!-- Shown when capability data is missing or partial; see UpdateCapabilityFilterAvailability. -->
            <TextBlock x:Name="CapabilityHint" Foreground="#B26A00" FontSize="11"
                       Margin="0,4,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
            <!-- How many rows the grid is showing and where they came from; see UpdateModelCount. -->
            <TextBlock x:Name="ModelCountLabel" FontSize="13" FontWeight="SemiBold" Foreground="#333"
                       Margin="0,10,0,0" />
        </StackPanel>

        <DataGrid Grid.Row="2" x:Name="ModelGrid"
                  ItemsSource="{Binding FilteredModels}" Loaded="OnModelGridLoaded"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  GridLinesVisibility="Horizontal"
                  BorderBrush="#DDD" BorderThickness="1"
                  ClipboardCopyMode="IncludeHeader"
                  MouseDoubleClick="OnRowDoubleClick">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copy selected row" Click="OnCopySelectedRow" InputGestureText="Ctrl+C" />
                    <MenuItem Header="Copy cell value" Click="OnCopyCellValue" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <!-- The list is browsed and sorted by the bare model name; the complete id, which is what
                     the API needs, stays in the tooltip and in every copy path (cell, row, Ctrl+C).
                     Matched fragments are painted, so a row always shows the text that got it listed. -->
                <DataGridTemplateColumn Header="Name" SortMemberPath="Name" ClipboardContentBinding="{Binding Id}" Width="220">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock TextTrimming="CharacterEllipsis"
                                       c:HighlightText.Source="{Binding Name}"
                                       c:HighlightText.Query="{Binding DataContext.NameQuery, RelativeSource={RelativeSource AncestorType=Window}}">
                                <TextBlock.ToolTip>
                                    <ToolTip MaxWidth="420">
                                        <TextBlock Text="{Binding Id}" TextWrapping="Wrap" />
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Owner is searched by the text filter, so it must stay visible. -->
                <DataGridTemplateColumn Header="Owner" SortMemberPath="OwnedBy" ClipboardContentBinding="{Binding OwnedBy}" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding OwnedBy}"
                                       c:HighlightText.Source="{Binding OwnedBy}"
                                       c:HighlightText.Query="{Binding DataContext.OwnerQuery, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- The icons alone are vague about direction, so the provider's raw words follow them.
                     These words are not searched by the text box — modality is the dropdown's job — so they
                     carry no match highlight either. -->
                <DataGridTemplateColumn Header="Modalities" SortMemberPath="ModalityWords" ClipboardContentBinding="{Binding Modalities}" Width="200" MinWidth="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding ModalityWords}"
                                       c:HighlightText.Prefix="{Binding Modalities}"
                                       c:HighlightText.Source="{Binding ModalityWords}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Context" Binding="{Binding ContextWindow}" Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="Margin" Value="0,0,4,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Prompt, $/1M" Binding="{Binding PromptPrice}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="Margin" Value="0,0,4,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Completion, $/1M" Binding="{Binding CompletionPrice}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="Margin" Value="0,0,4,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridCheckBoxColumn Header="Free" Binding="{Binding IsFree}" Width="45" />
                <!-- Capabilities is searched by the capability filter, so it must stay visible. -->
                <DataGridTextColumn Header="Capabilities" Binding="{Binding CapabilitiesText}" Width="130">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="ToolTip" Value="{Binding CapabilitiesText}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Description" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock TextTrimming="CharacterEllipsis"
                                       c:HighlightText.Source="{Binding Description}"
                                       c:HighlightText.Query="{Binding DataContext.DescriptionQuery, RelativeSource={RelativeSource AncestorType=Window}}">
                                <TextBlock.ToolTip>
                                    <ToolTip MaxWidth="420">
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Icons legend (modalities) -->
        <Border Grid.Row="3" Margin="0,8,0,0" Padding="8,6" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" >
                <TextBlock Text="Modalities:" FontWeight="SemiBold" Foreground="#555" Margin="0,0,10,0" />
                <TextBlock Text="📝 text" Margin="0,0,14,0" />
                <TextBlock Text="🖼 image" Margin="0,0,14,0" />
                <TextBlock Text="🔊 audio" Margin="0,0,14,0" />
                <TextBlock Text="🎬 video" Margin="0,0,14,0" />
                <TextBlock Text="📄 file" Margin="0,0,14,0" />
                <TextBlock Text="💻 code" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="SelectButton" Content="Select" IsDefault="True"
                    Padding="14,5" Margin="0,0,8,0" Click="OnSelect" />
            <Button Content="Cancel" IsCancel="True" Padding="14,5" />
        </StackPanel>
    </Grid>
</Window>
