<Window x:Class="ScraperTool.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ScraperTool.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="Application Settings"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ScraperTool;component/Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16" Grid.IsSharedSizeScope="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.ColumnSpan="2" Content="_Database path:" Margin="0,0,0,2" />
            <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding DatabasePath}" IsReadOnly="True"
                     Background="White" Foreground="#333" Margin="0,0,6,12" />
            <Button Grid.Row="1" Grid.Column="1" Content="Browse..." Command="{Binding BrowseDatabasePathCommand}"
                    HorizontalAlignment="Left" Margin="0,0,0,12" />

            <Label Grid.Row="2" Grid.ColumnSpan="2" Content="_Provider manifests path (ai-providers folder):" Margin="0,0,0,2" />
            <TextBox Grid.Row="3" Grid.Column="0" Text="{Binding ManifestPath}" IsReadOnly="True"
                     Background="White" Foreground="#333" Margin="0,0,6,12" />
            <Button Grid.Row="3" Grid.Column="1" Content="Browse..." Command="{Binding BrowseManifestPathCommand}"
                    HorizontalAlignment="Left" Margin="0,0,0,12" />

            <CheckBox Grid.Row="4" Grid.ColumnSpan="2" Content="Include local providers in reachability checks"
                      IsChecked="{Binding UseLocalProviders}" Margin="0,0,0,8" FontSize="12" />

            <Grid Grid.Row="5" Grid.ColumnSpan="2" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Re-validate manually confirmed providers after"
                           VerticalAlignment="Center" FontSize="12" />
                <TextBox Grid.Column="1" Text="{Binding RevalidationDays}" Margin="6,0,6,0"
                         Padding="4,2" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="days (0 = never)"
                           VerticalAlignment="Center" FontSize="12" Foreground="#888" />
            </Grid>

            <Grid Grid.Row="6" Grid.ColumnSpan="2" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="OptionColumn1" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="OptionColumn2" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Browser engine:" VerticalAlignment="Center" FontSize="12" />
                <RadioButton Grid.Column="1" Content="Playwright" GroupName="BrowserEngine"
                             IsChecked="{Binding IsPlaywrightEngine}" Margin="0,0,16,0" FontSize="12" />
                <RadioButton Grid.Column="2" Content="CloakBrowser" GroupName="BrowserEngine"
                             IsChecked="{Binding IsCloakBrowserEngine}" FontSize="12" />
            </Grid>

            <Grid Grid.Row="7" Grid.ColumnSpan="2" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="OptionColumn1" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="OptionColumn2" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Transcript mode:" VerticalAlignment="Center" FontSize="12" />
                <RadioButton Grid.Column="1" Content="None" GroupName="TranscriptMode"
                             IsChecked="{Binding IsTranscriptModeNone}" FontSize="12" />
                <RadioButton Grid.Column="2" Content="Transcript" GroupName="TranscriptMode"
                             IsChecked="{Binding IsTranscriptModeTranscript}" Margin="0,0,16,0" FontSize="12" />
                <RadioButton Grid.Column="3" Content="Debug transcript" GroupName="TranscriptMode"
                             IsChecked="{Binding IsTranscriptModeDebugTranscript}" FontSize="12" />
            </Grid>

            <TextBlock Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                       Text="Database path takes effect on next application restart. URL rules are in Config/url-intelligence-rules.json."
                       FontSize="11" Foreground="#888" VerticalAlignment="Center" Margin="0,0,6,0"
                       TextWrapping="Wrap" />
        </Grid>

        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="#DDD" Padding="16,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save and close" Command="{Binding SaveCommand}"
                        IsDefault="True" Padding="10,4" Margin="0,0,8,0"
                        Click="OnSaveAndClose" />
                <Button Content="Cancel" IsCancel="True" Padding="10,4" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
