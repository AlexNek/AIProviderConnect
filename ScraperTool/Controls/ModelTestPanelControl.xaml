<UserControl x:Class="ScraperTool.Controls.ModelTestPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ScraperTool.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ModelTestPanelViewModel}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Provider info bar -->
        <Border Grid.Row="0" Background="#F5F5F5" Padding="8,6" Margin="0,0,0,8" CornerRadius="4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Provider:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="{Binding ProviderLabel}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusText}" Foreground="#555" FontSize="12"
                           VerticalAlignment="Center" Margin="24,0,0,0" />
            </StackPanel>
        </Border>

        <!-- Tab control: Embeddings / Decision -->
        <TabControl Grid.Row="2">
            <!-- ── Embeddings tab ─────────────────────────────────────── -->
            <TabItem Header="Embeddings">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Model selection -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Model:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding EmbeddingModelId, UpdateSourceTrigger=PropertyChanged}"
                                 Width="300" VerticalContentAlignment="Center" IsReadOnly="True"
                                 Background="#FAFAFA" />
                        <Button Content="Select..." Command="{Binding SelectEmbeddingModelCommand}"
                                Margin="8,0,0,0" Padding="10,3" />
                        <TextBlock Text="{Binding ModelPriceText}" VerticalAlignment="Center"
                                   Foreground="#777" FontSize="11" Margin="16,0,0,0" />
                    </StackPanel>

                    <!-- Input -->
                    <GroupBox Grid.Row="1" Header="Input text" Padding="4" Margin="0,0,0,8">
                        <TextBox Text="{Binding EmbeddingInput, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="80" VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="12" />
                    </GroupBox>

                    <!-- Test button -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Test embedding" Command="{Binding TestEmbeddingCommand}"
                                Padding="16,5" FontWeight="SemiBold"
                                IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBool}}" />
                        <TextBlock Text="{Binding EmbeddingStatus}" VerticalAlignment="Center"
                                   Foreground="{Binding EmbeddingStatus, Converter={StaticResource StatusTextColor}}" Margin="12,0,0,0" />
                    </StackPanel>

                    <!-- Result -->
                    <GroupBox Grid.Row="3" Header="Result" Padding="4">
                        <TextBox Text="{Binding EmbeddingResult, Mode=OneWay}"
                                 IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="11"
                                 Background="#FAFAFA" />
                    </GroupBox>

                    <!-- Cumulative -->
                    <TextBlock Grid.Row="4" Text="{Binding EmbeddingCumulativeLabel}"
                               Foreground="#777" FontSize="11" Margin="0,4,0,0" />
                </Grid>
            </TabItem>

            <!-- ── Decision tab ───────────────────────────────────────── -->
            <TabItem Header="Decision">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Model selection -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Model:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding DecisionModelId, UpdateSourceTrigger=PropertyChanged}"
                                 Width="300" VerticalContentAlignment="Center" IsReadOnly="True"
                                 Background="#FAFAFA" />
                        <Button Content="Select..." Command="{Binding SelectDecisionModelCommand}"
                                Margin="8,0,0,0" Padding="10,3" />
                        <TextBlock Text="{Binding ModelPriceText}" VerticalAlignment="Center"
                                   Foreground="#777" FontSize="11" Margin="16,0,0,0" />
                    </StackPanel>

                    <!-- State -->
                    <GroupBox Grid.Row="1" Header="State (application context)" Padding="4" Margin="0,0,0,8">
                        <TextBox Text="{Binding DecisionState, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="60" VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="12" />
                    </GroupBox>

                    <!-- Questions -->
                    <GroupBox Grid.Row="2" Header="Questions" Padding="4" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DataGrid Grid.Row="0"
                                      ItemsSource="{Binding DecisionQuestions}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      BorderBrush="#DDD" BorderThickness="1"
                                      MaxHeight="180">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="80" />
                                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="80" />
                                    <DataGridTextColumn Header="Criteria / Scale"
                                                        Binding="{Binding CriteriaText}" Width="200" />
                                    <DataGridTextColumn Header="Instructions"
                                                        Binding="{Binding Instructions}" Width="*" />
                                    <DataGridTemplateColumn Header="" Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Remove"
                                                        Command="{Binding DataContext.RemoveQuestionCommand,
                                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="#C00" Cursor="Hand" FontSize="11" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Grid.Row="1" Content="+ Add question"
                                    Command="{Binding AddQuestionCommand}"
                                    Margin="0,4,0,0" Padding="10,3" HorizontalAlignment="Left" />
                        </Grid>
                    </GroupBox>

                    <!-- Test button -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Test decision" Command="{Binding TestDecisionCommand}"
                                Padding="16,5" FontWeight="SemiBold"
                                IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBool}}" />
                        <TextBlock Text="{Binding DecisionStatus}" VerticalAlignment="Center"
                                   Foreground="{Binding DecisionStatus, Converter={StaticResource StatusTextColor}}" Margin="12,0,0,0" />
                    </StackPanel>

                    <!-- Result -->
                    <GroupBox Grid.Row="4" Header="Result" Padding="4">
                        <TextBox Text="{Binding DecisionResult, Mode=OneWay}"
                                 IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="11"
                                 Background="#FAFAFA" />
                    </GroupBox>

                    <!-- Cumulative -->
                    <TextBlock Grid.Row="5" Text="{Binding DecisionCumulativeLabel}"
                               Foreground="#777" FontSize="11" Margin="0,4,0,0" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
