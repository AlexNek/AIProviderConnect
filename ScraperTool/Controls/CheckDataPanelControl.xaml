<UserControl
    x:Class="ScraperTool.Controls.CheckDataPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ScraperTool.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:ScraperTool.Models"
    xmlns:vm="clr-namespace:ScraperTool.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:CheckDataPanelViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="600"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            ── HEADER ───────────────────────────────────────────────────────────
            Elapsed time, status, progress, and Start button 
        -->
        <Border
            Grid.Row="0"
            Padding="16,12"
            Background="#FAFAFA"
            BorderBrush="#DDD"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Description text (left)  -->
                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,16,0"
                    VerticalAlignment="Center"
                    Foreground="#555"
                    Text="Validates all provider JSON files for missing fields, URL format, and reachability. Results are saved to the database."
                    TextWrapping="Wrap" />

                <!--  Status + Progress + Start + Cancel/Pause/Resume  -->
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#555"
                        Text="{Binding StatusText}" />
                    <ProgressBar
                        Width="100"
                        Height="14"
                        Margin="0,0,8,0"
                        IsIndeterminate="{Binding IsBusy}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <Button
                        Margin="8,0,0,0"
                        Padding="16,6"
                        Background="#009688"
                        BorderThickness="0"
                        Command="{Binding StartWorkCommand}"
                        Content="Start"
                        FontWeight="SemiBold"
                        Foreground="White"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    <Button
                        Margin="6,0,0,0"
                        Padding="10,4"
                        Background="#C62828"
                        BorderThickness="0"
                        Command="{Binding CancelOperationCommand}"
                        Content="Cancel"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                        IsEnabled="{Binding IsPaused, Converter={StaticResource InverseBool}}" />
                    <Button
                        Margin="6,0,0,0"
                        Padding="10,4"
                        Background="#E65100"
                        BorderThickness="0"
                        Command="{Binding PauseOperationCommand}"
                        Content="Pause"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                        IsEnabled="{Binding IsPaused, Converter={StaticResource InverseBool}}" />
                    <Button
                        Margin="6,0,0,0"
                        Padding="10,4"
                        Background="#009688"
                        BorderThickness="0"
                        Command="{Binding ResumeOperationCommand}"
                        Content="Resume"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--
            ─ SCROLLABLE CONTENT ───────────────────────────────────────────────
            Each child is a self-contained piece. Move/reorder/delete any independently.
        -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8">
                <!-- Empty state placeholder -->
                <Border Padding="48,32" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsBusy}" Value="False" />
                                        <Condition Binding="{Binding HasValidationIssues}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="No validation results yet" FontSize="16" FontWeight="SemiBold"
                                   Foreground="#555" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="Click Start to validate all provider definitions for missing fields, URL format, and reachability."
                                   FontSize="13" Foreground="#888" HorizontalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--  Provider validation status grid  -->
                <Border Margin="0,0,0,12" Padding="8" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#333">
                                <Run Text="Provider Validation Status (" />
                                <Run Text="{Binding ValidatedCount, Mode=OneWay}" />
                                <Run Text="/" />
                                <Run Text="{Binding TotalProviderCount, Mode=OneWay}" />
                                <Run Text=" validated)" />
                            </TextBlock>
                        </StackPanel>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding ValidationStates}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserReorderColumns="True"
                                  CanUserResizeColumns="True"
                                  CanUserSortColumns="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E8E8E8"
                                  Background="White"
                                  BorderBrush="#DDD"
                                  BorderThickness="1"
                                  RowHeight="28"
                                  MaxHeight="300"
                                  FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Provider ID" Binding="{Binding ProviderId}" Width="*" />
                                <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Padding" Value="4,2" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="{x:Static models:ValidationLevel.AutoValidated}">
                                                    <Setter Property="Foreground" Value="#2E7D32" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="{x:Static models:ValidationLevel.ValidationError}">
                                                    <Setter Property="Foreground" Value="#C62828" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="{x:Static models:ValidationLevel.ManuallyValidated}">
                                                    <Setter Property="Foreground" Value="#1565C0" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="{x:Static models:ValidationLevel.NotValidated}">
                                                    <Setter Property="Foreground" Value="#999" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Last Validated" Binding="{Binding LastValidatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}', TargetNullValue='—'}" Width="140" />
                                <DataGridTextColumn Header="By" Binding="{Binding ValidatedBy, TargetNullValue='—'}" Width="80" />
                                <DataGridTextColumn Header="Notes" Binding="{Binding Notes, TargetNullValue=''}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <controls:IssuesDataGridControl AiFixSingleIssueCommand="{Binding AiFixSingleIssueCommand}" ItemsSource="{Binding ValidationIssues}">
                    <controls:IssuesDataGridControl.Style>
                        <Style TargetType="controls:IssuesDataGridControl">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsBusy}" Value="False" />
                                        <Condition Binding="{Binding HasValidationIssues}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:IssuesDataGridControl.Style>
                </controls:IssuesDataGridControl>

                <TextBlock Margin="0,8" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding CurrentIssueCount, StringFormat='{}{0} issue(s) found'}" />
                            <Setter Property="Foreground" Value="#C62828" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsValidating}" Value="False">
                                    <Setter Property="Text" Value="{Binding CurrentIssueCount, StringFormat='{}{0} issue(s) found — saved to database'}" />
                                    <Setter Property="Foreground" Value="#666" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!--  AI Fix buttons — independent of token summary.  -->
                <Border Padding="8,4" Visibility="{Binding HasUrlIssues, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Button
                            Padding="10,4"
                            Background="#E65100"
                            BorderThickness="0"
                            Command="{Binding AiFixUrlsCommand}"
                            Content="Fix with AI"
                            FontWeight="SemiBold"
                            Foreground="White" />
                        <Button
                            Margin="6,0,0,0"
                            Padding="10,4"
                            Background="#C62828"
                            BorderThickness="0"
                            Command="{Binding AiRetryFailedCommand}"
                            Content="Retry Failed"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Visibility="{Binding HasFailedItems, Converter={StaticResource BoolToVis}}" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#666"
                            Text="Sends broken URLs to AI for correction suggestions" />
                    </StackPanel>
                </Border>

                <!--  AI setup banner  -->
                <Border Padding="8,4" Visibility="{Binding HasAiSetupNeeded, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#E65100"
                            Text="AI not configured — set it up to auto-fix broken URLs:" />
                        <Button
                            Padding="10,4"
                            Background="#E65100"
                            BorderThickness="0"
                            Command="{Binding OpenAiSetupCommand}"
                            Content="AI Setup"
                            FontWeight="SemiBold"
                            Foreground="White" />
                    </StackPanel>
                </Border>

                <controls:SuggestionDataGridControl
                    Visibility="{Binding HasAiSuggestions, Converter={StaticResource BoolToVis}}"
                    AccentBrush="#E65100"
                    AltRowBrush="#FFF3E0"
                    ApplyCommand="{Binding ApplyApprovedSuggestionsCommand}"
                    DeselectAllCommand="{Binding DeselectAllSuggestionsCommand}"
                    ItemsSource="{Binding AiSuggestions}"
                    SelectAllCommand="{Binding SelectAllSuggestionsCommand}" />

                <!--  ── Deep AI Analysis ────────────────────────────────────────────────  -->
                <Border Margin="0,16,0,0" Padding="12,8" Background="#F5F0FA" BorderBrush="#D1C4E9" BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Deep AI Analysis" FontSize="14" FontWeight="SemiBold" Foreground="#4A148C" />
                                <TextBlock Text="Sends each provider's full JSON to AI for semantic review (model count, descriptions, any field)."
                                           FontSize="12" Foreground="#777" TextWrapping="Wrap" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding DeepAnalysisStatusText}" FontSize="11" Foreground="#9575CD" Margin="0,2,0,0"
                                           Visibility="{Binding HasDeepAnalysisResults, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ProgressBar Width="80" Height="12" IsIndeterminate="{Binding IsDeepAnalysisBusy}"
                                             Visibility="{Binding IsDeepAnalysisBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0" />
                                <Button Padding="12,4" Background="#7B1FA2" BorderThickness="0"
                                        Command="{Binding RunDeepAnalysisCommand}"
                                        Content="Run Deep Analysis"
                                        FontWeight="SemiBold" Foreground="White"
                                        IsEnabled="{Binding IsDeepAnalysisBusy, Converter={StaticResource InverseBool}}" />
                                <Button Margin="6,0,0,0" Padding="8,3" Background="#C62828" BorderThickness="0"
                                        Command="{Binding CancelDeepAnalysisCommand}"
                                        Content="Cancel" FontWeight="SemiBold" Foreground="White"
                                        Visibility="{Binding IsDeepAnalysisBusy, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Grid>

                        <!--  Deep analysis suggestions  -->
                        <controls:SuggestionDataGridControl
                            Margin="0,8,0,0"
                            AccentBrush="#7B1FA2"
                            AltRowBrush="#F3E5F5"
                            ApplyCommand="{Binding ApplyDeepAnalysisSuggestionsCommand}"
                            DeselectAllCommand="{Binding DeselectAllDeepAnalysisSuggestionsCommand}"
                            ItemsSource="{Binding DeepAnalysisSuggestions}"
                            SelectAllCommand="{Binding SelectAllDeepAnalysisSuggestionsCommand}"
                            Visibility="{Binding HasDeepAnalysisResults, Converter={StaticResource BoolToVis}}" />

                        <!--  Deep analysis token + cost summary  -->
                        <Border Margin="0,4,0,0" Padding="6,4" Background="#EDE7F6" CornerRadius="3"
                                Visibility="{Binding HasDeepAnalysisTokenUsage, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Margin="0,0,6,0" FontWeight="SemiBold" Foreground="#4A148C" Text="Tokens:" />
                                <TextBlock Grid.Column="1" Margin="0,0,12,0"
                                           FontFamily="Cascadia Code, Consolas, Courier New" FontSize="12" Foreground="#555"
                                           Text="{Binding DeepAnalysisTokenSummary}" />
                                <TextBlock Grid.Column="2" FontSize="11" Foreground="#777"
                                           Text="{Binding DeepAnalysisCostSummary}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>

                        <!--  Deep analysis elapsed time  -->
                        <TextBlock Margin="0,4" FontFamily="Cascadia Code, Consolas, Courier New" FontSize="13"
                                   FontWeight="SemiBold" Foreground="#7B1FA2"
                                   Text="{Binding DeepAnalysisElapsedTime, FallbackValue='00:00:00'}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDeepAnalysisElapsedSummary}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!--  Token + cost summary  -->
                <Border
                    Padding="8,6"
                    Background="#F5F5F5"
                    BorderBrush="#DDD"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{Binding HasTokenUsage, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="#333"
                            Text="Tokens:" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            FontFamily="Cascadia Code, Consolas, Courier New"
                            FontSize="12"
                            Foreground="#555"
                            Text="{Binding TokenSummary}" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="#777"
                            Text="{Binding CostSummary}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>

                <!--  Elapsed time — persists as summary after operation completes.  -->
                <TextBlock
                    Margin="0,4"
                    VerticalAlignment="Center"
                    FontFamily="Cascadia Code, Consolas, Courier New"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="#009688"
                    Text="{Binding ElapsedTime, FallbackValue='00:00:00'}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Timer.IsRunning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasElapsedSummary}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <controls:LogPanelControl ItemsSource="{Binding Log}" />

            </StackPanel>
        </ScrollViewer>

        <!--  ── BOTTOM BAR ───────────────────────────────────────────────────────  -->
        <Border
            Grid.Row="2"
            Padding="12,6"
            Background="#E8E8E8">
            <StackPanel Orientation="Horizontal">
                <Button
                    Padding="8,2"
                    Command="{Binding ClearResultsCommand}"
                    Content="Clear results" />
                <Button
                    Margin="8,0,0,0"
                    Padding="8,2"
                    Command="{Binding CopyLogCommand}"
                    Content="Copy log" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
