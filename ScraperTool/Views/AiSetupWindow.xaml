<Window x:Class="ScraperTool.Views.AiSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ScraperTool.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:AiSetupViewModel}"
        Title="AI Provider Setup"
        MinHeight="260" Width="500" MinWidth="500"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ScraperTool;component/Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Content="AI _Provider:" Target="BrowseButton" Margin="0,0,0,2" />
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#CCC" BorderThickness="1" CornerRadius="3" Padding="8,6" Background="#FAFAFA">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedProvider.DisplayName, TargetNullValue='No provider selected'}"
                               FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Text="{Binding SelectedProvider.Summary, TargetNullValue=''}"
                               FontSize="11" Foreground="#666" />
                    <TextBlock Text="{Binding SelectedProvider.ModelDescription, TargetNullValue=''}"
                               FontSize="11" Foreground="#888" TextWrapping="Wrap"
                               Visibility="{Binding SelectedProvider.ModelDescription, Converter={StaticResource NonEmptyVis}}">
                        <TextBlock.ToolTip>
                            <ToolTip MaxWidth="400">
                                <TextBlock Text="{Binding SelectedProvider.ModelDescription}" TextWrapping="Wrap" />
                            </ToolTip>
                        </TextBlock.ToolTip>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Button Grid.Column="1" x:Name="BrowseButton" Content="Browse..."
                    Command="{Binding BrowseProvidersCommand}" Margin="8,0,0,0" Padding="10,4" />
        </Grid>

        <Label Grid.Row="2" Content="_API key:" Margin="0,0,0,2" />
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Content="Clear" Command="{Binding ClearApiKeyCommand}" Margin="6,0,0,0" Padding="8,2" />
        </Grid>

        <Border Grid.Row="4" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
            <StackPanel>
                <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </StackPanel>
        </Border>

        <Separator Grid.Row="5" Margin="0,0,0,6" />

        <Label Grid.Row="6" Content="Primary model:" Margin="0,0,0,2" FontSize="12" />
        <Grid Grid.Row="7" Margin="0,0,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding PrimaryModel}" Padding="4,2" Margin="0,0,6,0" />
            <Button Grid.Column="1" Content="Select model..." Command="{Binding SelectPrimaryModelCommand}"
                    Padding="8,2" />
        </Grid>
        <TextBlock Grid.Row="8" Text="{Binding PrimaryModelPriceText}"
                   FontSize="11" Foreground="#666" Margin="2,0,0,6" />

        <Label Grid.Row="9" Content="Fallback model:" Margin="0,0,0,2" FontSize="12" />
        <Grid Grid.Row="10" Margin="0,0,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding FallbackModel}" Padding="4,2" Margin="0,0,6,0" />
            <Button Grid.Column="1" Content="Select model..." Command="{Binding SelectFallbackModelCommand}"
                    Padding="8,2" />
        </Grid>
        <TextBlock Grid.Row="11" Text="{Binding FallbackModelPriceText}"
                   FontSize="11" Foreground="#666" Margin="2,0,0,6" />

        <StackPanel Grid.Row="12" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Content="Test connection" Command="{Binding TestConnectionCommand}"
                    IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBool}}"
                    Padding="10,4" Margin="0,0,8,0" />
            <Button Content="Save and close"
                    IsDefault="True" Padding="10,4" Margin="0,0,8,0"
                    Click="OnSaveAndClose" />
            <Button Content="Cancel" IsCancel="True" Padding="10,4" />
        </StackPanel>
    </Grid>
</Window>
